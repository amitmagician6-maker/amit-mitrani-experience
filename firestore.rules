rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'amitmagician6@gmail.com'
        ];
    }

    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'phone', 'email', 'interest', 'product', 'date', 'country',
        'city', 'participants', 'message', 'requestType', 'requestNumber',
        'status', 'notificationStatus', 'source', 'medium', 'campaign',
        'content', 'term', 'referrer', 'landingPage', 'formPage',
        'utmParameters', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() >= 2
      && request.resource.data.name.size() <= 100
      && request.resource.data.phone is string
      && request.resource.data.phone.size() >= 7
      && request.resource.data.phone.size() <= 30
      && request.resource.data.email is string
      && request.resource.data.email.size() <= 180
      && request.resource.data.interest is string
      && request.resource.data.interest.size() >= 2
      && request.resource.data.interest.size() <= 120
      && request.resource.data.message is string
      && request.resource.data.message.size() <= 1500
      && request.resource.data.requestType in ['booking_request', 'contact_request']
      && request.resource.data.status == 'pending'
      && request.resource.data.notificationStatus == 'not_configured'
      && request.resource.data.source is string
      && request.resource.data.source.size() <= 500
      && (!request.resource.data.keys().hasAny(['medium'])
        || (request.resource.data.medium is string && request.resource.data.medium.size() <= 120))
      && (!request.resource.data.keys().hasAny(['campaign'])
        || (request.resource.data.campaign is string && request.resource.data.campaign.size() <= 200))
      && (!request.resource.data.keys().hasAny(['content'])
        || (request.resource.data.content is string && request.resource.data.content.size() <= 300))
      && (!request.resource.data.keys().hasAny(['term'])
        || (request.resource.data.term is string && request.resource.data.term.size() <= 300))
      && (!request.resource.data.keys().hasAny(['referrer'])
        || (request.resource.data.referrer is string && request.resource.data.referrer.size() <= 1000))
      && (!request.resource.data.keys().hasAny(['landingPage'])
        || (request.resource.data.landingPage is string && request.resource.data.landingPage.size() <= 1000))
      && (!request.resource.data.keys().hasAny(['formPage'])
        || (request.resource.data.formPage is string && request.resource.data.formPage.size() <= 1000))
      && (!request.resource.data.keys().hasAny(['utmParameters'])
        || (request.resource.data.utmParameters is string && request.resource.data.utmParameters.size() <= 2000))
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /analyticsEvents/{eventId} {
      allow create: if request.resource.data.keys().hasOnly([
        'eventType', 'pagePath', 'pageTitle', 'target', 'targetLabel',
        'videoId', 'language', 'source', 'medium', 'campaign', 'content',
        'createdAt'
      ])
      && request.resource.data.eventType in [
        'page_view', 'youtube_click', 'whatsapp_click', 'phone_click',
        'email_click', 'form_submit', 'button_click', 'outbound_click',
        'scroll_depth'
      ]
      && request.resource.data.pagePath is string
      && request.resource.data.pagePath.size() <= 300
      && request.resource.data.pageTitle is string
      && request.resource.data.pageTitle.size() <= 200
      && request.resource.data.target is string
      && request.resource.data.target.size() <= 300
      && request.resource.data.targetLabel is string
      && request.resource.data.targetLabel.size() <= 160
      && request.resource.data.videoId is string
      && request.resource.data.videoId.size() <= 32
      && request.resource.data.language is string
      && request.resource.data.language.size() <= 8
      && request.resource.data.source is string
      && request.resource.data.source.size() <= 100
      && request.resource.data.medium is string
      && request.resource.data.medium.size() <= 100
      && request.resource.data.campaign is string
      && request.resource.data.campaign.size() <= 160
      && request.resource.data.content is string
      && request.resource.data.content.size() <= 160
      && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /invitations/{invitationId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'eventDate', 'eventTime', 'location', 'message', 'theme',
        'photoData', 'status', 'accessCodeId', 'expiresAt', 'createdAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() >= 2
      && request.resource.data.name.size() <= 40
      && request.resource.data.eventDate is string
      && request.resource.data.eventDate.size() == 10
      && request.resource.data.eventTime is string
      && request.resource.data.eventTime.size() <= 5
      && request.resource.data.location is string
      && request.resource.data.location.size() >= 2
      && request.resource.data.location.size() <= 80
      && request.resource.data.message is string
      && request.resource.data.message.size() <= 240
      && request.resource.data.theme in ['magic', 'celebration', 'elegant']
      && request.resource.data.photoData is string
      && request.resource.data.photoData.size() <= 430000
      && request.resource.data.status == 'active'
      && request.resource.data.accessCodeId is string
      && request.resource.data.accessCodeId.size() == 64
      && get(/databases/$(database)/documents/invitationAccess/$(request.resource.data.accessCodeId)).data.active == true
      && get(/databases/$(database)/documents/invitationAccess/$(request.resource.data.accessCodeId)).data.used == false
      && getAfter(/databases/$(database)/documents/invitationAccess/$(request.resource.data.accessCodeId)).data.used == true
      && getAfter(/databases/$(database)/documents/invitationAccess/$(request.resource.data.accessCodeId)).data.invitationId == invitationId
      && request.resource.data.expiresAt is timestamp
      && request.resource.data.expiresAt > request.time
      && request.resource.data.expiresAt < request.time + duration.value(400, 'd')
      && request.resource.data.createdAt == request.time;
      allow get: if isAdmin() || (resource.data.status == 'active' && resource.data.expiresAt > request.time);
      allow list, update, delete: if isAdmin();

      match /responses/{responseId} {
        allow create: if get(/databases/$(database)/documents/invitations/$(invitationId)).data.status == 'active'
          && get(/databases/$(database)/documents/invitations/$(invitationId)).data.expiresAt > request.time
          && request.resource.data.keys().hasOnly(['guestName', 'response', 'guestCount', 'note', 'createdAt'])
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() >= 2
          && request.resource.data.guestName.size() <= 60
          && request.resource.data.response in ['yes', 'no']
          && request.resource.data.guestCount is int
          && request.resource.data.guestCount >= 0
          && request.resource.data.guestCount <= 20
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 160
          && request.resource.data.createdAt == request.time;
        allow read, update, delete: if isAdmin();
      }
    }

    match /invitationAccess/{codeId} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource.data.active == true
        && resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt', 'invitationId'])
        && request.resource.data.used == true
        && request.resource.data.usedAt == request.time
        && request.resource.data.invitationId is string
        && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.accessCodeId == codeId
      );
    }

    match /siteContent/{pageId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'pagePath', 'payload', 'draftPayload', 'previousPayload', 'history',
          'updatedAt', 'updatedBy', 'draftUpdatedAt', 'draftUpdatedBy',
          'publishedAt', 'publishedBy'
        ])
        && request.resource.data.keys().hasAll([
          'pagePath', 'payload', 'draftPayload', 'previousPayload', 'history',
          'updatedAt', 'updatedBy'
        ])
        && request.resource.data.pagePath is string
        && request.resource.data.pagePath.size() <= 500
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 850000
        && request.resource.data.draftPayload is string
        && request.resource.data.draftPayload.size() <= 850000
        && request.resource.data.previousPayload is string
        && request.resource.data.previousPayload.size() <= 850000
        && request.resource.data.history is list
        && request.resource.data.history.size() <= 5
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email
        && (!request.resource.data.keys().hasAny(['draftUpdatedAt'])
          || request.resource.data.draftUpdatedAt is timestamp)
        && (!request.resource.data.keys().hasAny(['draftUpdatedBy'])
          || request.resource.data.draftUpdatedBy == request.auth.token.email)
        && (!request.resource.data.keys().hasAny(['publishedAt'])
          || request.resource.data.publishedAt is timestamp)
        && (!request.resource.data.keys().hasAny(['publishedBy'])
          || request.resource.data.publishedBy == request.auth.token.email);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
